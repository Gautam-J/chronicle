# Settings and secrets for deploy/. Copy to deploy/.env and fill in the values:
#   cp .env.example .env && chmod 600 .env
# deploy/.env is not in git. Generate a password with: openssl rand -base64 24

# HTTP listener. Loopback only: cloudflared is the one client.
CHRONICLE_ADDR=127.0.0.1:8300

# The JSON-lines file. /var/lib/chronicle is the StateDirectory of the unit;
# move it to the USB SSD when that is mounted.
CHRONICLE_DATA=/var/lib/chronicle/points.jsonl

# HTTP Basic auth for /owntracks/pub; the same pair goes into the OwnTracks
# app (Settings, Connection, Identification). The server will not start if
# either is empty.
CHRONICLE_OT_USER=gautam
CHRONICLE_OT_PASS=
